# Copiar este archivo como .env y completar. El .env NO se sube al repositorio.

# Broker MQTT (Mosquitto en el PC)
MQTT_HOST=localhost
MQTT_PORT=1883

# Base de datos MySQL (local para desarrollar; luego el servidor del laboratorio)
DB_HOST=localhost
DB_PORT=3306
DB_USER=clasifiot
DB_PASSWORD=cambiar_esta_clave
DB_NAME=clasifiot

# Producto que se clasifica: manzana o lata (latas de bebida, para probar)
PRODUCTO=lata

# Visión: índice de la webcam y carpeta de fotos.
# Por ahora se usa la webcam integrada del PC (0). Al conectar la externa,
# cambiar a su índice (normalmente 1); verificar con: python -m vision.listar_camaras
CAMERA_INDEX=0
IMAGES_DIR=data/imagenes

# Visión con IA (solo en el PC que corre la cámara)
# VISION_MOTOR: ia = modelo de Hugging Face (CLIP); opencv = reglas de color
VISION_MOTOR=opencv
HF_MODELO=openai/clip-vit-base-patch32
# Si la visión corre en otro PC que el servidor: http://IP-del-servidor:8000 (vacío = mismo PC)
SERVER_URL=

# Servidor web (dashboard)
API_PORT=8000

# Supervisor con LLM (fuera del MVP; se usará más adelante)
LLM_PROVIDER=ollama
LLM_MODEL=
OLLAMA_HOST=http://localhost:11434
