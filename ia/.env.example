# PC-IA. Copiar este archivo como .env (dentro de ia/) y completar. El .env NO se sube al repositorio.

# IP del PC-SERVIDOR (verla con ipconfig en ese PC). localhost = todo en el mismo PC.
MQTT_HOST=localhost
MQTT_PORT=1883
SERVER_URL=http://localhost:8000

# Producto que se clasifica: manzana o lata (latas de bebida, para probar)
PRODUCTO=manzana

# Webcam: 0 = la integrada del PC (por ahora). Al conectar la externa, cambiar a su índice
# (normalmente 1); verificar con: python -m vision.listar_camaras
CAMERA_INDEX=0
IMAGES_DIR=data/imagenes

# Motor de visión: ia = modelo de Hugging Face (CLIP en la GPU); opencv = reglas de color
VISION_MOTOR=ia
HF_MODELO=openai/clip-vit-base-patch32
