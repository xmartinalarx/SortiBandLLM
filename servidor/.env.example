# PC-SERVIDOR. Copiar este archivo como .env (dentro de servidor/) y completar.
# El .env NO se sube al repositorio. scripts/instalar_servidor.ps1 lo crea solo.

# Broker MQTT (Mosquitto corre en este mismo PC)
MQTT_HOST=localhost
MQTT_PORT=1883

# Base de datos MySQL (local para desarrollar; luego el servidor del laboratorio)
DB_HOST=localhost
DB_PORT=3306
DB_USER=clasifiot
DB_PASSWORD=cambiar_esta_clave
DB_NAME=clasifiot

# Producto que se clasifica: manzana o lata (se anota en cada lote)
PRODUCTO=manzana

# Carpeta donde quedan las fotos que sube el PC-IA
IMAGES_DIR=data/imagenes

# Servidor web (API + dashboard)
API_PORT=8000

# Supervisor con LLM (fuera del MVP; se usará más adelante)
LLM_PROVIDER=ollama
LLM_MODEL=
OLLAMA_HOST=http://localhost:11434
